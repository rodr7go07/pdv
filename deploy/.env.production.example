# Plantilla del .env de PRODUCCIÓN. Copiar a /var/www/punto-de-venta/.env y llenar los datos marcados.
# Después:  php artisan key:generate   (una sola vez; guarda una copia de la APP_KEY en un lugar seguro)

APP_NAME="Punto de Venta"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://TU-DOMINIO.COM
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX
APP_KEY=

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=punto_venta
DB_USERNAME=pdv
DB_PASSWORD=LA-CONTRASEÑA-QUE-MOSTRÓ-provision.sh
DB_TIMEZONE=-06:00

# Sesiones y colas en la base de datos; cookies solo por HTTPS
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Contraseña del administrador inicial (solo se usa la primera vez que se instala).
# Cámbiala desde "Mi cuenta" en cuanto entres.
ADMIN_PASSWORD=ESCRIBE-UNA-CONTRASEÑA-LARGA

# ── Respaldos a DigitalOcean Spaces (opcional pero MUY recomendado) ──
# Estas variables también se pueden poner en /etc/pdv-respaldo.env (permisos 600).
SPACES_BUCKET=
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_KEY=
SPACES_SECRET=
SPACES_PREFIJO=respaldos-pdv
DIAS_RETENCION=30

# ── Avisos de salud (opcional) ──
URL_SITIO=https://TU-DOMINIO.COM
AVISO_CORREO=
AVISO_WEBHOOK=
